<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <header><%- include('partials/navbar') %></header>
    <main>
      <section class="mainSection">
        <div class="chapterTitle">
          <h1><%= langData.sections.about %></h1>
        </div>
        <%- include('partials/about', { about: langData.about }) %>
      </section>
      <section class="mainSection">
        <div class="chapterTitle">
          <h1><%= langData.sections.experience %></h1>
        </div>
        <%-include('partials/experience', {experience: langData.experience}) %>
      </section>
      <section class="mainSection">
        <div class="chapterTitle">
          <h1><%= langData.sections.projects %></h1>
        </div>
        <% langData.projects.forEach(project => { %> <%-
        include("partials/project", { project }) %> <% }) %>
      </section>
      <section class="mainSection">
        <div class="chapterTitle">
          <h1><%= langData.sections.contact %></h1>
        </div>
        <%- include('partials/contact') %>
      </section>
    </main>
    <%- include('partials/foot') %>
  </body>
</html>
