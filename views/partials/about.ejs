<link rel="stylesheet" href="/about.css" />

<div class="content">
  <img src="<%= about[0].image.src %>" alt="<%= about[0].image.alt %>" />

  <div class="text-content">
    <p><%= about[0].description %></p>
    <div>
      <h2><%=about[0].title.personalSkillsTitle%></h2>
      <ul>
        <% about[0].personalSkills.forEach(skill => { %>
        <li><%= skill %></li>
        <% }) %>
      </ul>
      <p>
        <strong><%=about[0].title.technicalSkillsTitle%>:</strong> <%=
        about[0].technicalSkills.summary %>
      </p>
      <p>
        <strong><%=about[0].title.techLanguageTitle%>:</strong> <%=
        about[0].technicalSkills.languages.join(", ") %>
      </p>
      <p>
        <strong><%=about[0].title.techTechnologyTitle%>:</strong> <%=
        about[0].technicalSkills.technologies.join(", ") %>
      </p>
      <p>
        <strong><%=about[0].title.techAgileTitle%>:</strong> <%=
        about[0].technicalSkills.agile %>
      </p>
    </div>
  </div>
</div>
