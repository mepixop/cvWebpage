<link rel="stylesheet" href="/experience.css" />
<div class="experience-content">
  <section class="experience">
    <h3><%= experience[0].title.titleFirstTable %></h3>
    <table class="experience-table">
      <tr>
        <th><%= experience[0].title.tableCol1 %></th>
        <th><%= experience[0].title.tableCol2 %></th>
      </tr>
      <tr>
        <% experience[0].work.forEach(function(exp) { %>
      </tr>

      <tr>
        <td><%= exp.timeframe %></td>
        <td>
          <strong><%= exp.position %></strong><br />
          <%= exp.company %><br />
          <%- exp.details.join('<br />') %>
        </td>
      </tr>
      <% }); %>
    </table>
  </section>

  <section class="education">
    <h3><%= experience[0].title.titleSecondTable %></h3>
    <table class="experience-table">
      <tr>
        <th><%= experience[0].title.tableCol1 %></th>
        <th><%= experience[0].title.tableCol2 %></th>
      </tr>
      <% experience[0].education.forEach(function(edu) { %>
      <tr>
        <td><%= edu.timeframe %></td>
        <td>
          <strong><%= edu.title %></strong><br />
          <%= edu.school %><br /><%= edu.details%>
        </td>
      </tr>
      <% }); %>
    </table>
  </section>
</div>
